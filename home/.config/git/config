[user]
	name = O6lvl4
	email = hiromi.motodera@aid-on.org

# This machine only (work identity, signing key, …). Never committed.
[include]
	path = local

# HTTPS everywhere, authenticated by gh. No SSH keys to carry around.
[credential "https://github.com"]
	helper =
	helper = !\"$HOME/.local/bin/gh\" auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !\"$HOME/.local/bin/gh\" auth git-credential
[url "https://github.com/"]
	insteadOf = git@github.com:

[init]
	defaultBranch = main
[core]
	pager = less -FRX
[commit]
	verbose = true
[push]
	default = current
	autoSetupRemote = true
	followTags = true
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[fetch]
	prune = true
	pruneTags = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = default
	renames = copies
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt

[alias]
	st = status -sb
	sw = switch
	co = checkout
	lg = log --graph --format='%C(auto)%h%d %s %C(8)%cr · %an'
	last = log -1 --stat
	amend = commit --amend --no-edit
	undo = reset --soft HEAD~1
	wip = !git add -A && git commit -qm wip
	gone = !git branch -vv | awk '/: gone]/{print $1}' | xargs -r git branch -D
