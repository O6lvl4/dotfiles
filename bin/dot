#!/bin/zsh
# dot — the only command this repo has.
#
#   dot up        link + tools + langs   (safe to re-run any time)
#   dot link      symlink home/ into $HOME
#   dot tools     install / update the binaries listed in ./tools
#                 (--check: resolve every asset for every platform, install nothing)
#   dot langs     install + globally pin the toolchains in ./langs via qusp
#   dot repos     clone every repo of the owners in ./repos into ~/workspace
#   dot sync      dot repos, then fetch + fast-forward every repo in ~/workspace
#   dot doctor    show what is and isn't in place
#   dot edit      cd into this repo
emulate -L zsh
setopt err_return pipe_fail no_unset extended_glob

DOT=${0:A:h:h}
BIN=$HOME/.local/bin
STATE=${XDG_STATE_HOME:-$HOME/.local/state}/dot
WORKSPACE=${WORKSPACE:-$HOME/workspace}

# ── output ──────────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  c_dim=$'\e[2m' c_ok=$'\e[32m' c_warn=$'\e[33m' c_err=$'\e[31m' c_acc=$'\e[38;5;179m' c_off=$'\e[0m'
else
  c_dim= c_ok= c_warn= c_err= c_acc= c_off=
fi
step() { print -r -- "${c_acc}◆${c_off} $*" }
ok()   { print -r -- "  ${c_ok}✓${c_off} $*" }
skip() { print -r -- "  ${c_dim}· $*${c_off}" }
warn() { print -r -- "  ${c_warn}!${c_off} $*" }
die()  { print -r -- "  ${c_err}✗${c_off} $*" >&2; return 1 }

# Lines of a config file, without comments or blank lines.
entries() { local l; for l in "${(@f)$(<$DOT/$1)}"; do l=${l%%\#*}; [[ -n ${l//[[:space:]]/} ]] && print -r -- $l; done }

# ── machine ─────────────────────────────────────────────────────────────
# DOT_OS / DOT_ARCH override detection (dot tools --check walks every platform).
os()        { print -r -- ${DOT_OS:-${(L)$(uname -s)}} }               # darwin | linux
is_arm()    { [[ ${DOT_ARCH:-$(uname -m)} == (arm64|aarch64) ]] }
arch_rust() { is_arm && print aarch64 || print x86_64 }
arch_go()   { is_arm && print arm64   || print amd64 }
arch_std()  { is_arm && print arm64   || print x86_64 }
# Every spelling of "this OS" that release assets use.
os_re() { [[ $(os) == darwin ]] && print -r -- '(macOS|macos|darwin|apple-darwin)' \
                                || print -r -- '(linux|unknown-linux-musl|unknown-linux-gnu)' }

sha256() { (( $+commands[sha256sum] )) && sha256sum $1 | awk '{ print $1 }' || shasum -a 256 $1 | awk '{ print $1 }' }

# Xcode.app selected but its license not accepted (and no sudo to accept it):
# every /usr/bin dev tool dies with exit 69. The Command Line Tools copy works.
needs_clt() {
  [[ -d /Library/Developer/CommandLineTools ]] || return 1
  env -u DEVELOPER_DIR /usr/bin/git --version >/dev/null 2>&1 && return 1
  return 0
}

# The Command Line Tools linker can be older than the newest SDK it ships
# ("tapi error: unknown architecture arm64e.x1-macos"), which breaks every
# C / Rust / cgo link. Prints the newest SDK that links, if the default doesn't.
pick_sdk() {
  local clt=/Library/Developer/CommandLineTools t sdk
  [[ -d $clt/SDKs ]] || return 1
  t=$(mktemp -d)
  {
    print 'int main(void) { return 0; }' > $t/a.c
    local -x DEVELOPER_DIR=${DEVELOPER_DIR:-}
    needs_clt && DEVELOPER_DIR=$clt
    env -u SDKROOT /usr/bin/cc $t/a.c -o $t/a >/dev/null 2>&1 && return 1
    local -a sdks=( $clt/SDKs/MacOSX[0-9]*.sdk(N/) )         # real dirs, not alias links
    for sdk in ${(On)sdks}; do
      SDKROOT=$sdk /usr/bin/cc $t/a.c -o $t/a >/dev/null 2>&1 && { print -r -- $sdk; return 0 }
    done
    return 1
  } always {
    rm -rf $t
  }
}

# ── link ────────────────────────────────────────────────────────────────
cmd_link() {
  step "link  ${c_dim}$DOT/home → ~${c_off}"
  local src rel dst
  for src in $DOT/home/**/*(.D); do
    rel=${src#$DOT/home/}
    dst=$HOME/$rel
    if [[ -L $dst && ${dst:A} == ${src:A} ]]; then skip $rel; continue; fi
    mkdir -p ${dst:h}
    if [[ -e $dst || -L $dst ]]; then
      mv $dst $dst.pre-dot
      warn "$rel  ${c_dim}(old one kept as $rel.pre-dot)${c_off}"
    fi
    ln -s $src $dst
    ok $rel
  done

  # Machine-local overrides live outside the repo.
  local zlocal=$HOME/.config/zsh/local.zsh glocal=$HOME/.config/git/local
  [[ -e $zlocal ]] || print -r -- "# This machine only. Not tracked." > $zlocal
  [[ -e $glocal ]] || print -r -- "# This machine only. Not tracked." > $glocal
  if needs_clt && ! grep -q DEVELOPER_DIR $zlocal; then
    print -r -- "export DEVELOPER_DIR=/Library/Developer/CommandLineTools  # Xcode license not accepted" >> $zlocal
    ok "local.zsh  ${c_dim}DEVELOPER_DIR → CommandLineTools${c_off}"
  fi
  local sdk
  if ! grep -q SDKROOT $zlocal && sdk=$(pick_sdk); then
    print -r -- "export SDKROOT=$sdk  # default SDK is newer than this linker understands" >> $zlocal
    ok "local.zsh  ${c_dim}SDKROOT → ${sdk:t}${c_off}"
  fi

  # Superseded by ~/.config/zsh and ~/.config/git. Moved aside, never deleted.
  local old
  for old in .zshrc .zprofile .gitconfig; do
    [[ -f $HOME/$old && ! -L $HOME/$old ]] || continue
    mv $HOME/$old $HOME/$old.pre-dot
    warn "$old  ${c_dim}(superseded, kept as $old.pre-dot)${c_off}"
  done

  mkdir -p $BIN
  [[ ${${:-$BIN/dot}:A} == $DOT/bin/dot ]] || { ln -sf $DOT/bin/dot $BIN/dot; ok "~/.local/bin/dot" }
}

# ── tools: binaries straight from GitHub releases ───────────────────────
gh_api() {
  if [[ -x $BIN/gh ]] && $BIN/gh auth status >/dev/null 2>&1; then
    $BIN/gh api $1
  else
    local -a auth=()
    local token=${GH_TOKEN:-${GITHUB_TOKEN:-}}
    [[ -n $token ]] && auth=( -H "Authorization: Bearer $token" )     # 60/h → 5000/h
    curl -fsSL $auth -H 'Accept: application/vnd.github+json' https://api.github.com/$1
  fi
}

# jq parses every release listing, so it has to exist before the first one.
# macOS 15+ ships it; elsewhere fetch the static binary, checked against
# jq's own sha256sum.txt. `dot tools` keeps it updated after that.
ensure_jq() {
  (( $+commands[jq] )) && return 0
  local name=jq-${${$(os):s/darwin/macos}}-$(arch_go) base=https://github.com/jqlang/jq/releases/latest/download t
  t=$(mktemp -d)
  {
    curl -fsSL -o $t/jq $base/$name && curl -fsSL -o $t/sums $base/sha256sum.txt || { die "jq  download failed"; return 1 }
    [[ $(awk -v a=$name '$2 == a { print $1 }' $t/sums) == $(sha256 $t/jq) ]] || { die "jq  sha256 mismatch"; return 1 }
    mkdir -p $BIN && install -m 755 $t/jq $BIN/jq && hash -r
    ok "jq  ${c_dim}bootstrapped${c_off}"
  } always {
    rm -rf $t
  }
}

# expand_pattern <regex with {placeholders}>
expand_pattern() {
  local p=$1
  p=${p//\{rust\}/$(arch_rust)}
  p=${p//\{go\}/$(arch_go)}
  p=${p//\{arch\}/$(arch_std)}
  p=${p//\{os\}/$(os_re)}
  print -r -- $p
}

# pick_asset <release json> <regex> → asset name. Prefers musl over gnu builds
# (static, runs on any distro).
pick_asset() {
  jq -r --arg p "^$2\$" '[.assets[].name | select(test($p))] | sort_by(test("gnu")) | .[0] // empty' <<<$1
}

# install_tool <name> <owner/repo> <asset regex> [alias,...]
install_tool() {
  local name=$1 repo=$2 pattern=$(expand_pattern $3) aliases=${4:-} json tag asset url sums tmp bin

  json=$(gh_api repos/$repo/releases/latest) || { die "$name  could not reach $repo"; return 1 }
  tag=$(jq -r .tag_name <<<$json)
  # argv[0] aliases (qusp → quspx) are just symlinks to the same binary.
  local alias
  for alias in ${(s:,:)aliases}; do ln -sf $name $BIN/$alias; done

  if [[ -x $BIN/$name && -f $STATE/tools/$name && $(<$STATE/tools/$name) == $tag ]]; then
    skip "$name $tag"; return 0
  fi

  asset=$(pick_asset $json $pattern)
  [[ -n $asset ]] || { die "$name  no $(os)-$(arch_std) asset matching $pattern in $repo $tag"; return 1 }
  url=$(jq -r --arg a $asset '.assets[] | select(.name == $a) | .browser_download_url' <<<$json)

  tmp=$(mktemp -d)
  {
    curl -fsSL -o $tmp/$asset $url

    # sha256 from GitHub's own asset digest, plus the publisher's checksum
    # file when there is one. Every one we have must match.
    local got want digest checked=0
    got=$(sha256 $tmp/$asset)
    digest=$(jq -r --arg a $asset '.assets[] | select(.name == $a) | .digest // empty' <<<$json)
    if [[ $digest == sha256:* ]]; then
      [[ ${digest#sha256:} == $got ]] || { die "$name  sha256 mismatch (GitHub digest) for $asset"; return 1 }
      checked=1
    fi
    sums=$(jq -r --arg a $asset '[.assets[] | select(.name == ($a + ".sha256") or (.name | test("(?i)checksums|sha256sums"))) | .browser_download_url][0] // empty' <<<$json)
    if [[ -n $sums ]]; then
      want=$(curl -fsSL $sums | awk -v a=$asset 'NF == 1 || $2 == a || $2 == "*"a { print $1; exit }')
      [[ $want == $got ]] || { die "$name  sha256 mismatch (published checksums) for $asset"; return 1 }
      checked=1
    fi
    (( checked )) || warn "$name  ${c_dim}no digest or checksum available, unverified${c_off}"

    mkdir -p $tmp/x $BIN
    case $asset in
      *.zip)    (( $+commands[ditto] )) && ditto -x -k $tmp/$asset $tmp/x || unzip -q $tmp/$asset -d $tmp/x ;;
      *.tar.gz|*.tgz) tar -xzf $tmp/$asset -C $tmp/x ;;
      *)        cp $tmp/$asset $tmp/x/$name ;;
    esac
    bin=( $tmp/x/**/$name(.N) )
    [[ -n $bin ]] || { die "$name  no '$name' binary inside $asset"; return 1 }

    # A bin/ with share/ or lib/ beside it (nvim) needs its whole tree:
    # keep it under ~/.local/opt/<name> and link the binary.
    local root=${bin[1]:h:h}
    if [[ ${bin[1]:h:t} == bin && ( -d $root/share || -d $root/lib ) ]]; then
      local opt=$HOME/.local/opt/$name
      rm -rf $opt.new && mkdir -p ${opt:h} && cp -R $root $opt.new
      rm -rf $opt && mv $opt.new $opt
      rm -f $BIN/$name && ln -s $opt/bin/$name $BIN/$name
    else
      install -m 755 $bin[1] $BIN/$name
    fi

    mkdir -p $STATE/tools
    print -r -- $tag > $STATE/tools/$name
    ok "$name $tag"
  } always {
    rm -rf $tmp
  }
}

cmd_tools() {
  [[ ${1:-} == --check ]] && { tools_check; return }
  step "tools  ${c_dim}→ ~/.local/bin${c_off}"
  ensure_jq || return 1
  local line failed=0
  for line in ${(f)"$(entries tools)"}; do
    install_tool ${=line} || failed=1
  done
  return $failed
}

# Does every tool still publish an asset our regex finds, on every platform?
# Catches upstream renames before a fresh machine does.
tools_check() {
  step "tools --check  ${c_dim}every asset × every platform${c_off}"
  ensure_jq || return 1
  local -a plats=( darwin:arm64 darwin:x86_64 linux:x86_64 linux:aarch64 )
  local -a required=( darwin:arm64 linux:x86_64 )                     # what we run (and CI tests)
  local line plat json asset failed=0 row
  local -a f
  for line in ${(f)"$(entries tools)"}; do
    f=( ${=line} )
    json=$(gh_api repos/$f[2]/releases/latest) || { die "$f[1]  could not reach $f[2]"; failed=1; continue }
    row=''
    for plat in $plats; do
      asset=$(DOT_OS=${plat%:*} DOT_ARCH=${plat#*:} expand_pattern $f[3] | { read -r p; pick_asset $json $p })
      if [[ -n $asset ]]; then row+=" ${c_ok}$plat${c_off}"
      elif (( $required[(Ie)$plat] )); then row+=" ${c_err}$plat✗${c_off}"; failed=1
      else row+=" ${c_warn}$plat·${c_off}"; fi
    done
    print -r -- "  ${(r:9:)f[1]}$row"
  done
  return $failed
}

# ── langs: toolchains via qusp ──────────────────────────────────────────
# `latest` → newest stable release, `24` → newest 24.x, anything else as-is.
resolve_version() {
  local lang=$1 want=$2 v
  local -a hits
  [[ $want == latest || $want == [0-9]## || $want == [0-9]##.[0-9]## ]] || { print -r -- $want; return }
  for v in ${(f)"$($BIN/qusp list --remote $lang 2>/dev/null)"}; do
    v=${v//$'\e'\[[0-9;]#m/}; v=${${v## #}%% *}                 # drop color and "(LTS)"
    [[ ${v#go} == [0-9]##(.[0-9]##)# ]] || continue            # skip rc / beta / channels
    [[ $want == latest || ${v#go} == $want || ${v#go} == $want.* ]] && hits+=$v
  done
  (( $#hits )) || return 1
  hits=( ${(On)hits} )                                          # list order varies by backend
  print -r -- $hits[1]
}

cmd_langs() {
  step "langs  ${c_dim}via qusp${c_off}"
  [[ -x $BIN/qusp ]] || { die "qusp missing — run: dot tools"; return 1 }
  local line lang want version pinned
  pinned=$($BIN/qusp pin list 2>/dev/null)
  for line in ${(f)"$(entries langs)"}; do
    lang=${${=line}[1]} want=${${=line}[2]}
    version=$(resolve_version $lang $want) || { warn "$lang $want  ${c_dim}no matching release${c_off}"; continue }
    if [[ $pinned == *"$lang"*"$version"* ]]; then skip "$lang $version"; continue; fi
    if $BIN/qusp install $lang $version >/dev/null 2>&1 &&
       $BIN/qusp pin set $lang $version >/dev/null 2>&1; then
      ok "$lang $version"
    else
      warn "$lang $version  ${c_dim}failed — try: qusp install $lang $version${c_off}"
    fi
  done
}

# ── repos: mirror whole accounts into ~/workspace/github.com/<owner>/<repo>
cmd_repos() {
  step "repos  ${c_dim}→ $WORKSPACE/github.com${c_off}"
  [[ -x $BIN/gh ]] && $BIN/gh auth status >/dev/null 2>&1 \
    || { die "gh is not logged in — run: gh auth login"; return 1 }
  local owner list=()
  for owner in ${(f)"$(entries repos)"}; do
    list+=( ${(f)"$($BIN/gh repo list $owner -L 5000 --json nameWithOwner -q '.[].nameWithOwner')"} )
  done
  local -a todo=()
  local r
  for r in $list; do [[ -d $WORKSPACE/github.com/$r/.git ]] || todo+=$r; done
  skip "$(( $#list - $#todo )) already cloned"
  (( $#todo )) || return 0

  # 8 at a time; each clone reports for itself.
  print -rl -- $todo | xargs -P 8 -n 1 $DOT/bin/dot _clone
}

cmd__clone() {
  local r=$1 dst=$WORKSPACE/github.com/$1 err
  mkdir -p ${dst:h}
  if err=$(git clone -q https://github.com/$r.git $dst 2>&1); then ok $r; else die "$r  ${err##*$'\n'}"; fi
}

# ── sync: clone what's new, fast-forward what's behind ──────────────────
# Only ever fast-forwards the checked-out branch. Anything that would need a
# merge, a stash or a guess (diverged, conflicting local edits) is reported
# and left alone.
cmd_sync() {
  cmd_repos || warn "skipping new clones"
  step "sync  ${c_dim}fetch + fast-forward${c_off}"
  local root=$WORKSPACE/github.com
  local -a all=( $root/*/*/.git(ND/:h) )        # D: Aid-On/.github too
  all=( ${all#$root/} )
  (( $#all )) || { skip "nothing in $root"; return 0 }

  local line kind r detail n=0 same=0 pulled=0 bad=0
  local -a quiet=()
  # 8 at a time; each worker prints one "kind<TAB>repo<TAB>detail" line.
  print -rl -- $all | xargs -P 8 -n 1 $DOT/bin/dot _sync | while IFS=$'\t' read -r kind r detail; do
    (( ++n ))
    [[ -t 1 ]] && print -n -- "\r\e[K  ${c_dim}$n/$#all${c_off}"
    [[ -t 1 && $kind != same ]] && print -n -- "\r\e[K"
    case $kind in
      same)     (( ++same )) ;;
      pulled)   (( ++pulled )); ok "$r  ${c_dim}$detail${c_off}" ;;
      noup)     quiet+=$r ;;
      ahead)    skip "$r  $detail" ;;
      *)        (( ++bad )); warn "$r  ${c_dim}$detail${c_off}" ;;
    esac
  done
  [[ -t 1 ]] && print -n -- "\r\e[K"
  (( $#quiet )) && skip "no upstream: ${(j:, :)quiet}"
  skip "$same up to date"
  (( pulled + bad )) && print -r -- "  ${c_dim}$pulled pulled, $bad need a look${c_off}"
  return 0
}

cmd__sync() {
  local r=$1 g=( git -C $WORKSPACE/github.com/$1 ) err branch ahead behind
  if ! err=$($g fetch --prune --quiet 2>&1); then print -r -- "failed	$r	fetch: ${err##*$'\n'}"; return 0; fi
  $g rev-parse -q --verify HEAD >/dev/null || { print -r -- "same	$r"; return 0 }    # empty repo
  branch=$($g symbolic-ref --short -q HEAD) || { print -r -- "detached	$r	detached HEAD"; return 0 }
  $g rev-parse -q --verify '@{u}' >/dev/null || { print -r -- "noup	$r	$branch"; return 0 }
  print -r -- $($g rev-list --left-right --count 'HEAD...@{u}') | read -r ahead behind
  if (( ! behind )); then
    (( ahead )) && print -r -- "ahead	$r	$branch ↑$ahead unpushed" || print -r -- "same	$r"
    return 0
  fi
  (( ahead )) && { print -r -- "diverged	$r	$branch ↑$ahead ↓$behind, needs a merge or rebase"; return 0 }
  # --ff-only refuses on its own if local edits would be overwritten.
  if err=$($g merge --ff-only --quiet '@{u}' 2>&1); then
    print -r -- "pulled	$r	$branch +$behind"
  else
    print -r -- "dirty	$r	$branch ↓$behind, local changes in the way"
  fi
}

# ── doctor ──────────────────────────────────────────────────────────────
cmd_doctor() {
  step doctor
  local src rel bad=0
  for src in $DOT/home/**/*(.D); do
    rel=${src#$DOT/home/}
    [[ -L $HOME/$rel && ${${:-$HOME/$rel}:A} == $src:A ]] && continue
    warn "$rel not linked"; bad=1
  done
  (( bad )) || ok "home/ fully linked"

  [[ :$PATH: == *:$BIN:* ]] && ok "~/.local/bin on PATH" || warn "~/.local/bin not on PATH"
  needs_clt && [[ ${DEVELOPER_DIR:-} != *CommandLineTools* ]] && warn "Xcode license not accepted and DEVELOPER_DIR unset"
  git --version >/dev/null 2>&1 && ok "$(git --version)" || warn "git does not run"

  local line name
  for line in ${(f)"$(entries tools)"}; do
    name=${${=line}[1]}
    [[ -x $BIN/$name ]] && ok "$name ${$(cat $STATE/tools/$name 2>/dev/null):-}" || warn "$name missing"
  done
  if [[ -x $BIN/gh ]]; then
    local who=$($BIN/gh api user -q .login 2>/dev/null)
    [[ -n $who ]] && ok "gh logged in as $who" || warn "gh not logged in"
  fi
  [[ -x $BIN/qusp ]] && $BIN/qusp pin list 2>/dev/null | sed 's/^/    /'

  # Startup budget: an interactive shell should feel instant.
  zmodload zsh/datetime
  local -F t0=$EPOCHREALTIME
  zsh -i -c exit >/dev/null 2>&1 </dev/null
  local -i ms=$(( (EPOCHREALTIME - t0) * 1000 ))
  (( ms < 150 )) && ok "zsh starts in ${ms}ms" || warn "zsh starts in ${ms}ms  ${c_dim}(zsh -i -x -c exit to see why)${c_off}"
  return 0
}

# Pull this repo first, so `dot up` on any machine means "the latest setup".
# Only fast-forwards a clean checkout of a branch; anything else is left alone.
self_update() {
  local g=( git -C $DOT ) before
  $g symbolic-ref -q HEAD >/dev/null && $g rev-parse -q --verify '@{u}' >/dev/null || return 0
  before=$($g rev-parse HEAD)
  if ! $g pull --ff-only --quiet >/dev/null 2>&1; then
    warn "dotfiles  ${c_dim}could not fast-forward, using the local copy${c_off}"; return 0
  fi
  [[ $($g rev-parse HEAD) == $before ]] && return 0
  ok "dotfiles  ${c_dim}${before[1,7]} → $($g rev-parse --short HEAD)${c_off}"
  DOT_UPDATED=1 exec $DOT/bin/dot up                                 # rerun the new version
}

cmd_up() {
  step "dotfiles  ${c_dim}$DOT${c_off}"
  [[ -n ${DOT_UPDATED:-} ]] && skip "updated" || self_update
  cmd_link; cmd_tools; cmd_langs
}

cmd_help() { sed -n '2,12s/^# \{0,1\}//p' $DOT/bin/dot }

case ${1:-help} in
  up|link|tools|langs|repos|sync|doctor|help|_clone|_sync) cmd=${1:-help}; (( $# )) && shift; cmd_$cmd "$@" ;;
  edit) print -r -- $DOT ;;
  *) die "unknown command: $1"; cmd_help; exit 1 ;;
esac
